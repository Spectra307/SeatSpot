# Server
PORT=4000
NODE_ENV=development

# MongoDB replica set
MONGO_URI=mongodb://127.0.0.1:27017/seatspot?replicaSet=rs0
MONGODB_DB_NAME=seatspot

# Auth and OTP storage
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
REDIS_PASSWORD=replace-with-a-strong-redis-password
OTP_TTL_SECONDS=300
# Logical partition used for consumer accounts that are not tied to a restaurant.
AUTH_PARTITION_RESTAURANT_ID=000000000000000000000001

# Optional. When unset, nearby search uses the locally seeded MongoDB catalogue.
GOOGLE_MAPS_API_KEY=

# Optional demo staff account seed; use a strong local-only password.
DEMO_STAFF_PASSWORD=replace-with-a-strong-demo-password
