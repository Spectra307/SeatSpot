# Server
PORT=4000
NODE_ENV=development

# MongoDB (use a replica set locally; Atlas connection string in production)
MONGODB_URI=mongodb://127.0.0.1:27017/seatspot?replicaSet=rs0
MONGODB_DB_NAME=seatspot

# Auth and OTP storage
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
OTP_TTL_SECONDS=300
# Logical partition used for consumer accounts that are not tied to a restaurant.
AUTH_PARTITION_RESTAURANT_ID=000000000000000000000001

# Redis. REDIS_URL is used by the app and may be redis:// or rediss:// (TLS).
# The local Docker Compose stack uses REDIS_PASSWORD, and the app falls back to
# REDIS_HOST/REDIS_PORT/REDIS_PASSWORD when REDIS_URL is unset.
REDIS_URL=redis://:replace-with-a-strong-redis-password@127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-redis-password

# Allowed browser origin for CORS and Socket.IO (no trailing slash).
# Development also always allows http://localhost:5173.
CLIENT_ORIGIN=http://localhost:5173

# Optional. When unset, nearby search uses the locally seeded MongoDB catalogue.
GOOGLE_MAPS_API_KEY=

# Optional demo staff account seed; use a strong local-only password.
DEMO_STAFF_PASSWORD=replace-with-a-strong-demo-password

# ── Email / Brevo HTTP API ──────────────────────────────────────────────────
# In development, when BREVO_API_KEY or EMAIL_FROM is absent, OTPs are printed
# to the server console. In production both values are required.
EMAIL_FROM=no-reply@seatspot.app
BREVO_API_KEY=
