# Server
PORT=4000
NODE_ENV=development

# MongoDB replica set
MONGO_URI=mongodb://127.0.0.1:27017/seatspot?replicaSet=rs0
MONGODB_DB_NAME=seatspot

# Auth and OTP storage
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
REDIS_PASSWORD=replace-with-a-strong-redis-password
OTP_TTL_SECONDS=300
# Logical partition used for consumer accounts that are not tied to a restaurant.
AUTH_PARTITION_RESTAURANT_ID=000000000000000000000001

# Optional. When unset, nearby search uses the locally seeded MongoDB catalogue.
GOOGLE_MAPS_API_KEY=

# Optional demo staff account seed; use a strong local-only password.
DEMO_STAFF_PASSWORD=replace-with-a-strong-demo-password

# ── Email / SMTP ────────────────────────────────────────────────────────────
# All fields are optional in development.
# When SMTP_HOST is absent: OTPs are printed to the server console (dev only)
# and booking emails are silently skipped.
# In production, set all five variables to enable email delivery.
#
# Compatible with any SMTP server. To use Resend, set:
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<api-key>
# To use SendGrid:
#   SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USER=apikey  SMTP_PASS=<api-key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SeatSpot <no-reply@seatspot.app>
