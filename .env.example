# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/seatspot
MONGODB_DB_NAME=seatspot

# Auth and OTP storage
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
REDIS_URL=redis://127.0.0.1:6379
OTP_TTL_SECONDS=300
# Logical partition used for consumer accounts that are not tied to a restaurant.
AUTH_PARTITION_RESTAURANT_ID=000000000000000000000001
